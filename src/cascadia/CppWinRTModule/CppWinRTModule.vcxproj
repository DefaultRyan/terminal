<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B98CEC4F-A0E2-4EA0-B81F-D10CAF3B8B05}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>CppWinRTModule</RootNamespace>
    <ProjectName>CppWinRTModule</ProjectName>
    <TargetName>CppWinRTModule</TargetName>
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <SubSystem>Console</SubSystem>

    <!-- sets a bunch of Windows Universal properties -->
    <OpenConsoleUniversalApp>true</OpenConsoleUniversalApp>

    <!-- Module builder: generate per-namespace .ixx files -->
    <CppWinRTBuildModule>true</CppWinRTBuildModule>
    <CppWinRTGenerateWindowsMetadata>false</CppWinRTGenerateWindowsMetadata>

    <!-- Required: generated .ixx files do `import std;` which needs the STL module.
         Note: this leaks std.ixx.ifc to consumers via AdditionalBMIDirectories.
         Consumer projects with CppWinRTBuildModule=true must also set
         BuildStlModules=true to avoid import-then-include STL conflicts. -->
    <BuildStlModules>true</BuildStlModules>

    <!-- No namespace filter on the module builder — include all platform namespaces. -->
  </PropertyGroup>
  <PropertyGroup Label="NuGet Dependencies">
    <TerminalCppWinrt>true</TerminalCppWinrt>
  </PropertyGroup>
  <Import Project="..\..\..\common.openconsole.props" Condition="'$(OpenConsoleDir)'==''" />
  <Import Project="$(OpenConsoleDir)src\common.nugetversions.props" />
  <Import Project="$(OpenConsoleDir)src\cppwinrt.build.pre.props" />

  <!-- Override PCH: module builder cannot use precompiled headers. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderFile />
      <PrecompiledHeaderOutputFile />
      <!-- Enable classic COM IUnknown support in the module so consumers
           that implement COM interfaces (e.g. XAML types) work correctly. -->
      <PreprocessorDefinitions>WINRT_ENABLE_LEGACY_COM;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Workaround: BuildStlModules=true doesn't create the STL IFC output
       directory, causing std.ixx compilation to fail on clean builds. -->
  <Target Name="EnsureStlModuleOutputDir" BeforeTargets="ClCompile;FixupCLCompileOptions;ComputeCLOutputs">
    <MakeDir Directories="$(IntDir)microsoft\STL\" />
  </Target>

  <!-- No source files needed — the NuGet targets add .ixx files automatically
       via CppWinRTAddModuleInterfaces when CppWinRTBuildModule=true. -->

  <!-- MUX/WinUI and WebView2 modules are built here via TerminalMUX NuGet.
       Consumer projects use CppWinRTModuleExclude to avoid rebuilding
       namespaces already provided by their static lib dependencies. -->

  <!-- Add the XAML Hosting contract WinMD so the platform module includes
       WindowsXamlManager and other hosting types. -->
  <Target Name="CppWinRTAddHostingContract"
          BeforeTargets="GetCppWinRTPlatformWinMDInputs"
          DependsOnTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <CppWinRTPlatformWinMDReferences Include="$(WindowsSDK_MetadataPathVersioned)\Windows.UI.Xaml.Hosting.HostingContract\*\*.winmd" />
    </ItemGroup>
  </Target>

  <!-- Add MUX and WebView2 WinMDs as platform inputs so their modules
       are built by the shared module builder, not by each consumer. -->
  <Target Name="CppWinRTAddMuxWinMDs"
          BeforeTargets="GetCppWinRTPlatformWinMDInputs"
          DependsOnTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <CppWinRTPlatformWinMDReferences Include="$(OpenConsoleDir)packages\Microsoft.UI.Xaml.2.8.4\lib\uap10.0\Microsoft.UI.Xaml.winmd" />
      <CppWinRTPlatformWinMDReferences Include="$(WebView2PackageRoot)\lib\Microsoft.Web.WebView2.Core.winmd" />
    </ItemGroup>
  </Target>

  <Import Project="$(OpenConsoleDir)src\cppwinrt.build.post.props" />
  <Import Project="$(OpenConsoleDir)src\common.nugetversions.targets" />
</Project>
